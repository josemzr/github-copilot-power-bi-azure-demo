{
  "name": "github-copilot-power-bi-backend",
  "version": "1.0.0",
  "description": "Azure Functions backend for the GitHub Copilot Power BI demo",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc && npm run copy:sample",
    "copy:sample": "mkdir -p dist/data && cp ../samples/copilot_metrics_response_sample.json dist/data/copilot_metrics_response_sample.json",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "node dist/src/server.js",
    "start:functions": "func start",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.11.1",
    "@azure/storage-blob": "^12.28.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0"
  }
}