		lineageTag: 7f39cf17-9263-474e-b99a-aa1eac3849c5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column display_formula = Config[total_devs] & " devs X $" & Config[avg_hourly_salary] & "/hr X " & Config[annual_work_weeks] & " weeks X " & Config[average_weekly_hour_savings] & "/hrs ="
		lineageTag: d8ade074-4296-416e-baa6-a4b38df5e31a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column forecast_savings = Config[total_devs] * Config[avg_hourly_salary] * Config[annual_work_weeks] * Config[average_weekly_hour_savings]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d0944715-8de6-4ce1-acc5-5920347e9b86
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column expected_daily_savings = Config[total_devs] * Config[avg_hourly_salary] * (Config[average_weekly_hour_savings]/5)
		dataType: int64
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 644b3672-d018-40e1-8422-b039a2a53f38
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	partition config = m
		mode: import
		source =
				let
				    Source = #table({"Last refresh"}, {{DateTime.Time(DateTime.LocalNow()) & DateTime.Date(DateTime.LocalNow())}}),
