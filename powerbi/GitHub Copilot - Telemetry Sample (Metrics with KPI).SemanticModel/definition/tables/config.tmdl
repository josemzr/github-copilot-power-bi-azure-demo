			defaultHierarchy: LocalDateTable_7a5db9ed-af0c-407b-ba15-aefaf35ee6c2.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column total_devs = 200
		formatString: 0
		lineageTag: 65159688-4b72-4485-aaa0-42c62243f522
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column avg_hourly_salary = 50
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 0ca9afbb-969f-4625-82e2-45fbad5f526b
		summarizeBy: sum

